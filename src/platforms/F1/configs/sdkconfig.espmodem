#
# ESP Modem Configuration
#
# This file contains ESP Modem specific configuration for LTE functionality

CONFIG_ESP_MODEM_CMUX_DEFRAGMENT_PAYLOAD=y
CONFIG_ESP_MODEM_USE_INFLATABLE_BUFFER_IF_NEEDED=y
CONFIG_ESP_MODEM_CMUX_DELAY_AFTER_DLCI_SETUP=100
CONFIG_ESP_MODEM_CMUX_USE_SHORT_PAYLOADS_ONLY=n
CONFIG_ESP_MODEM_ADD_CUSTOM_MODULE=n
CONFIG_ESP_MODEM_C_API_STR_MAX=128
CONFIG_ESP_MODEM_URC_HANDLER=y
CONFIG_ESP_MODEM_PPP_ESCAPE_BEFORE_EXIT=n
CONFIG_ESP_MODEM_USE_PPP_MODE=y

# Enable debug logs to see UART TX/RX communication
#CONFIG_ESP_MODEM_ADD_DEBUG_LOGS=y

# Enable development mode for additional debugging
#CONFIG_ESP_MODEM_ENABLE_DEVELOPMENT_MODE=y

