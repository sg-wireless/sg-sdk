+// SafeBoot condition enumeration
+typedef enum {
+    __safeboot_cond_none            = 0,
+    __safeboot_cond_latest_firmware = 1,
+    __safeboot_cond_prev_user_update = 2,
+    __safeboot_cond_factory_firmware = 3,
+    __safeboot_cond_software_request = 4,
+} safeboot_cond_t;
+
+// SafeBoot condition mapping structure
+typedef struct {
+    safeboot_cond_t cond;
+    int hold_time;
+} safeboot_cond_node_t;
+
+// Global condition array - ordered by hold time (longest first for proper matching)
+static safeboot_cond_node_t s_safeboot_conds[4];
+static int s_safeboot_conds_count = 0;
+
+// SafeBoot interface state enumeration is now defined in boot_if.h
+
+static const char* get_safeboot_cond_str(safeboot_cond_t cond)
+{
+    switch(cond) {
+        case __safeboot_cond_none:              return "none";
+        case __safeboot_cond_latest_firmware:   return "latest_firmware";
+        case __safeboot_cond_prev_user_update:  return "prev_user_update";
+        case __safeboot_cond_factory_firmware:  return "factory_firmware";
+        case __safeboot_cond_software_request:  return "software_request";
+        default:                                return "unknown";
+    }
+}
+
+static void insert_safeboot_cond(safeboot_cond_t cond, int hold_time)
+{
+    if (s_safeboot_conds_count >= sizeof(s_safeboot_conds)/sizeof(s_safeboot_conds[0])) {
+        return; // Array full
+    }
+    
+    // Insert in descending order of hold_time
+    int insert_idx = s_safeboot_conds_count;
+    for (int i = 0; i < s_safeboot_conds_count; i++) {
+        if (hold_time > s_safeboot_conds[i].hold_time) {
+            insert_idx = i;
+            break;
+        }
+    }
+    
+    // Shift existing elements to make space
+    for (int i = s_safeboot_conds_count; i > insert_idx; i--) {
+        s_safeboot_conds[i] = s_safeboot_conds[i-1];
+    }
+    
+    // Insert new element
+    s_safeboot_conds[insert_idx].cond = cond;
+    s_safeboot_conds[insert_idx].hold_time = hold_time;
+    s_safeboot_conds_count++;
+}
+
+static safeboot_cond_t get_safeboot_matched_cond(int hold_time)
+{
+    ESP_LOGI(g_safeboot_tag, "Matching hold time: %d seconds", hold_time);
+
+    // Official SafeBoot timing logic based on incremental detection:
+    // - hold_time = 1: T < 3s (latest firmware in SafeBoot)
+    // - hold_time = 3: 3s ≤ T < 7s (previous OTA in SafeBoot) 
+    // - hold_time = 7: T ≥ 7s (factory firmware in SafeBoot)
+    
+    if (hold_time == 1) {
+        // Short press (T < 3s) - Latest firmware in SafeBoot mode
+        ESP_LOGI(g_safeboot_tag, "Short press detected - selecting latest firmware for SafeBoot mode");
+        return __safeboot_cond_latest_firmware;
+    } else if (hold_time == 3) {
+        // Medium press (3s ≤ T < 7s) - Previous OTA in SafeBoot mode
+        ESP_LOGI(g_safeboot_tag, "Medium press detected - selecting previous OTA for SafeBoot mode");
+        return __safeboot_cond_prev_user_update;
+    } else if (hold_time >= 7) {
+        // Long press (T ≥ 7s) - Factory firmware in SafeBoot mode  
+        ESP_LOGI(g_safeboot_tag, "Long press detected - selecting factory firmware for SafeBoot mode");
+        return __safeboot_cond_factory_firmware;
+    }
+
+    // Fallback - should not reach here with our logic
+    ESP_LOGW(g_safeboot_tag, "Unexpected hold_time %d, defaulting to latest firmware", hold_time);
+    return __safeboot_cond_latest_firmware;
+}
+
+/**
+ * Feed the RTC WDT to prevent timeout during long button holds
+ * Note: In bootloader context, we rely on short incremental waits (3s+2s+2s)
+ * rather than WDT feeding to prevent timeouts
+ */
+static void feed_rtc_wdt(void)
+{
+    // In bootloader context, WDT HAL is not available
+    // Our incremental timing approach (3s+2s+2s) should prevent WDT timeouts
+    ESP_LOGD(g_safeboot_tag, "WDT feeding not available in bootloader - using incremental timing");
+}
+
+/**
+ * Configure GPIO for SafeBoot button with proper pull-down resistor
+ * This is critical after WDT resets as GPIO configuration is lost
+ */
+static void configure_safeboot_gpio(uint32_t gpio_num)
+{
+    // For GPIO21 on ESP32-S3, configure pull-down resistor via RTC domain
+    if (gpio_num == 21) {
+        // Enable RTC domain for GPIO21
+        REG_SET_BIT(RTC_IO_RTC_PAD21_REG, RTC_IO_PAD21_MUX_SEL);
+        
+        // Configure as input with pull-down
+        REG_CLR_BIT(RTC_IO_RTC_PAD21_REG, RTC_IO_PAD21_FUN_IE);     // Disable input
+        REG_SET_BIT(RTC_IO_RTC_PAD21_REG, RTC_IO_PAD21_FUN_IE);     // Enable input
+        REG_CLR_BIT(RTC_IO_RTC_PAD21_REG, RTC_IO_PAD21_RUE);       // Disable pull-up
+        REG_SET_BIT(RTC_IO_RTC_PAD21_REG, RTC_IO_PAD21_RDE);       // Enable pull-down
+        
+        ESP_LOGD(g_safeboot_tag, "GPIO %d configured with pull-down via RTC domain", gpio_num);
+    } else {
+        ESP_LOGW(g_safeboot_tag, "GPIO %d configuration not implemented", gpio_num);
+    }
+}
+
+/**
+ * ESP-IDF v5.4+ compatible GPIO hold time detection
+ * Replaces the removed bootloader_common_get_gpio_hold_time() function
+ * 
+ * Uses incremental timing approach (3s + 2s + 2s = 7s) with RTC WDT feeding
+ * This prevents WDT resets while checking longer button hold times
+ */
+static bool get_gpio_hold_time_v54(uint32_t gpio_num, uint32_t max_hold_time, 
+                                   bool level, uint32_t* detected_hold_time)
+{
+    ESP_LOGD(g_safeboot_tag, "Checking GPIO %d hold time for level %d", gpio_num, level);
+    
+    if (detected_hold_time == NULL) {
+        ESP_LOGE(g_safeboot_tag, "detected_hold_time parameter is NULL");
+        return false;
+    }
+    
+    // Configure GPIO first - critical after WDT resets
+    configure_safeboot_gpio(gpio_num);
+    
+    *detected_hold_time = 0;
+    
+    // Check if GPIO is even at the target level initially
+    esp_comm_gpio_hold_t result = bootloader_common_check_long_hold_gpio_level(gpio_num, 0, level);
+    if (result == GPIO_NOT_HOLD) {
+        ESP_LOGD(g_safeboot_tag, "GPIO %d not at target level %d", gpio_num, level);
+        return false;
+    }
+    
+    // Incremental timing approach: 3s + check for 7s total
+    // Feed RTC WDT before longer wait to prevent timeouts
+    
+    // Step 1: Check for 3s hold (latest vs previous OTA distinction)
+    ESP_LOGD(g_safeboot_tag, "Checking GPIO %d hold for 3s", gpio_num);
+    result = bootloader_common_check_long_hold_gpio_level(gpio_num, 3, level);
+    
+    if (result == GPIO_SHORT_HOLD) {
+        // Button released before 3s - latest firmware in SafeBoot
+        ESP_LOGI(g_safeboot_tag, "GPIO %d held for less than 3s", gpio_num);
+        *detected_hold_time = 1; // Indicate short press for latest firmware
+        return true;
+    } else if (result == GPIO_NOT_HOLD) {
+        ESP_LOGD(g_safeboot_tag, "GPIO %d not held at 3s threshold", gpio_num);
+        return false;
+    }
+    
+    // Button held for at least 3s - could be previous OTA or factory
+    ESP_LOGI(g_safeboot_tag, "GPIO %d held for at least 3s", gpio_num);
+    *detected_hold_time = 3;
+    
+    // Feed RTC WDT before longer waits to prevent timeout
+    feed_rtc_wdt();
+    
+    // Step 2: Check if we need to wait longer (for factory firmware at 7s)
+    // Use incremental approach: 3s + 2s + 2s = 7s total to prevent WDT timeouts
+    if (max_hold_time >= 7) {
+        ESP_LOGD(g_safeboot_tag, "Checking GPIO %d hold for additional 2s (5s total)", gpio_num);
+        result = bootloader_common_check_long_hold_gpio_level(gpio_num, 2, level);
+        
+        if (result == GPIO_SHORT_HOLD) {
+            // Button released during 2nd wait (3-5s total) - still previous OTA
+            ESP_LOGI(g_safeboot_tag, "GPIO %d released during 2nd wait (3-5s total)", gpio_num);
+            *detected_hold_time = 3; // Keep 3s value for previous OTA
+            return true;
+        } else if (result == GPIO_NOT_HOLD) {
+            // GPIO not held - keep 3s detection from Step 1
+            return true;
+        }
+        
+        // Feed RTC WDT again before final check
+        feed_rtc_wdt();
+        
+        // Step 3: Final check for 7s total (factory firmware)
+        ESP_LOGD(g_safeboot_tag, "Checking GPIO %d hold for final 2s (7s total)", gpio_num);
+        result = bootloader_common_check_long_hold_gpio_level(gpio_num, 2, level);
+        
+        if (result == GPIO_LONG_HOLD) {
+            // Button held for 7s or more - factory firmware
+            ESP_LOGI(g_safeboot_tag, "GPIO %d held for at least 7s", gpio_num);
+            *detected_hold_time = 7;
+        } else if (result == GPIO_SHORT_HOLD) {
+            // Button released during 3rd wait (5-7s total) - still previous OTA
+            ESP_LOGI(g_safeboot_tag, "GPIO %d released during 3rd wait (5-7s total)", gpio_num);
+            *detected_hold_time = 3; // Keep 3s value for previous OTA
+        }
+        // Note: If GPIO_NOT_HOLD, we keep the 3s detection from Step 1
+    }
+    
+    return true;
+}
