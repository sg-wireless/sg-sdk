+static int get_safeboot_condition(void)
+{
+    #ifndef CONFIG_SAFEBOOT_SWITCH_BUTTON_ENABLE
+
+    return __safeboot_cond_none;
+
+    #else /* CONFIG_SAFEBOOT_SWITCH_BUTTON_ENABLE */
+
+    int max_hold_time = 0;
+
+    #ifndef __max
+    #define __max_defined
+    #define __max(x,y)  ((x) >= (y) ? (x) : (y))
+    #endif
+
+    // Configure SafeBoot conditions based on Kconfig settings
+    #ifdef CONFIG_SAFEBOOT_HOLD_TIME_FOR_LATEST_FW
+        max_hold_time = __max(CONFIG_SAFEBOOT_HOLD_TIME_FOR_LATEST_FW, max_hold_time);
+        insert_safeboot_cond(__safeboot_cond_latest_firmware,
+            CONFIG_SAFEBOOT_HOLD_TIME_FOR_LATEST_FW);
+    #endif
+
+    #if defined(CONFIG_SAFEBOOT_ENABLE_PREV_OTA) && defined(CONFIG_SAFEBOOT_HOLD_TIME_FOR_PREV_OTA)
+        max_hold_time = __max(CONFIG_SAFEBOOT_HOLD_TIME_FOR_PREV_OTA, max_hold_time);
+        insert_safeboot_cond(__safeboot_cond_prev_user_update,
+            CONFIG_SAFEBOOT_HOLD_TIME_FOR_PREV_OTA);
+    #endif
+
+    #if defined(CONFIG_SAFEBOOT_ENABLE_FACTORY_FIRMWARE) && defined(CONFIG_SAFEBOOT_HOLD_TIME_FOR_FACTORY_FIRMWARE)
+        max_hold_time = __max(CONFIG_SAFEBOOT_HOLD_TIME_FOR_FACTORY_FIRMWARE, max_hold_time);
+        insert_safeboot_cond(__safeboot_cond_factory_firmware,
+            CONFIG_SAFEBOOT_HOLD_TIME_FOR_FACTORY_FIRMWARE);
+    #endif
+
+    #ifdef __max_defined
+    #undef __max_defined
+    #undef __max
+    #endif
+
+    if( max_hold_time == 0 )
+    {
+        ESP_LOGI(g_safeboot_tag, "SafeBoot button disabled - no hold times configured");
+        return __safeboot_cond_none;
+    }
+
+    bool checked_level = false;
+
+    #ifdef CONFIG_SAFEBOOT_PIN_LEVEL_HIGH
+        checked_level = true;
+    #endif
+
+    ESP_LOGI(g_safeboot_tag, "Checking GPIO %d for SafeBoot press (level=%d, max=%ds)", 
+             CONFIG_SAFEBOOT_PIN_NUM, checked_level, max_hold_time);
+
+    uint32_t detected_hold_time = 0;
+    bool detected_safeboot_press = get_gpio_hold_time_v54(
+        CONFIG_SAFEBOOT_PIN_NUM,
+        max_hold_time, 
+        checked_level,
+        &detected_hold_time);
+
+    int safeboot_cond = __safeboot_cond_none;
+    if(detected_safeboot_press)
+    {
+        safeboot_cond = get_safeboot_matched_cond(detected_hold_time);
+        // Force SafeBoot mode for ANY button press, regardless of duration
+        bootif_state_set(__BOOTIF_STATE_SAFEBOOT_MODE);
+        ESP_LOGI(g_safeboot_tag, "SafeBoot button detected - booting in SafeBoot mode with condition: %s", 
+                get_safeboot_cond_str(safeboot_cond));
+    }
+    else
+    {
+        // No button press detected - check for existing software SafeBoot request
+        // Don't overwrite bootif_state if software SafeBoot (Ctrl+F) is already set
+        if (bootif_state_get() != __BOOTIF_STATE_SAFEBOOT_MODE) {
+            bootif_state_set(__BOOTIF_STATE_NORMAL_MODE);
+            ESP_LOGI(g_safeboot_tag, "No SafeBoot button press - booting in normal mode");
+        } else {
+            ESP_LOGI(g_safeboot_tag, "No SafeBoot button press, but software SafeBoot request detected");
+        }
+    }
+
+    return safeboot_cond;
+
+    #endif /* CONFIG_SAFEBOOT_SWITCH_BUTTON_ENABLE */
+}
