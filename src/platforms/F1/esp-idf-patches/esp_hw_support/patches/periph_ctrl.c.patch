+periph_module_t periph_module_get_id(const char* name)
+{
+    int i;
+    for(i=0; i < PERIPH_MODULE_MAX; ++i)
+    {
+        // Safety check to prevent crashes with missing string entries
+        if (i < sizeof(s_periph_modules_str)/sizeof(s_periph_modules_str[0]) && 
+            s_periph_modules_str[i] && 
+            strcmp(name, s_periph_modules_str[i]) == 0)
+        {
+            return i;
+        }
+    }
+    return PERIPH_MODULE_MAX;
+}
+
+void periph_module_list(void)
+{
+    int i;
+    for(i=0; i < PERIPH_MODULE_MAX; ++i)
+    {
+        // Safety check to prevent crashes with missing string entries
+        const char* name = (i < sizeof(s_periph_modules_str)/sizeof(s_periph_modules_str[0]) && s_periph_modules_str[i]) 
+                          ? s_periph_modules_str[i] 
+                          : "UNKNOWN";
+        
+        if(ref_counts[i])
+        {
+            __log_enforce("%2d %s : %d\n", i, name, ref_counts[i]);
+        }
+        else
+        {
+            __log_enforce("%2d %s : 0\n", i, name);
+        }
+    }
+}
