 static mp_obj_t network_ppp___del__(mp_obj_t self_in);
+static mp_obj_t network_ppp_poll(size_t n_args, const mp_obj_t *args);
+
+// lwIP timer callback - reads directly from UART and feeds to PPP
+static void network_ppp_poll_timer_cb(void *arg) {
+    network_ppp_obj_t *self = (network_ppp_obj_t *)arg;
+    
+    if (self->state >= STATE_ACTIVE && self->poll_timer_active && self->pcb != NULL) {
+        // Read directly from UART without going through MicroPython
+        uint8_t buf[256];
+        int len = uart_read_bytes(self->uart_num, buf, sizeof(buf), 0);  // Non-blocking
+        if (len > 0) {
+            // Feed data directly to PPP stack (thread-safe)
+            pppos_input(self->pcb, (u8_t *)buf, len);
+        }
+        
+        // Re-schedule the timer
+        sys_timeout(PPP_POLL_INTERVAL_MS, network_ppp_poll_timer_cb, self);
+    }
+}
 
