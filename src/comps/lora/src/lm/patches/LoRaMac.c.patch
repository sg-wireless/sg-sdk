+void lm_mac_force_stop( void )
+{
+    // Put radio to sleep so no new RX events can be queued.
+    Radio.Sleep();
+    // Force the state machine into IDLE and clear all pending radio events
+    // so that LoRaMacIsBusy() returns false and LoRaMacDeInitialization()
+    // succeeds when called during teardown (e.g. on a soft reset).
+    MacCtx.MacState = LORAMAC_IDLE;
+    MacCtx.AllowRequests = LORAMAC_REQUEST_HANDLING_ON;
+    LoRaMacRadioEvents.Value = 0;
+}
